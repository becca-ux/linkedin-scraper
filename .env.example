# Amplemarket API
AMPLEMARKET_API_KEY=your_amplemarket_api_key_here

# Proxycurl API (LinkedIn search & enrichment — optional, for direct LinkedIn search)
PROXYCURL_API_KEY=your_proxycurl_api_key_here

# Serper.dev API (Google search for LinkedIn profiles — used by Auto Source)
SERPER_API_KEY=your_serper_api_key_here

# Anthropic / Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string
DATABASE_URL=sqlite:///candidates.db

# API authentication (leave blank to disable in dev)
API_KEY=

# Scheduler (daily, weekly)
SCORING_SCHEDULE=daily
